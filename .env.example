# ---- API ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://higherstudy:higherstudy@localhost:5432/higherstudy
REDIS_URL=redis://localhost:6379
# 32+ random chars. Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# Access tokens are short-lived; the session renews them via an httpOnly refresh cookie.
ACCESS_TOKEN_TTL=15m
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
# Leave unset: Secure cookies in production, plain-http cookies in development.
COOKIE_SECURE=
# Shared by api and web: lets the API trust the client IP the web proxy forwards. Required in production.
PROXY_SECRET=
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
# Set to 1 when a proxy/load balancer sits in front (Railway, Render, nginx) so rate limits use the real client IP.
TRUST_PROXY=

# ---- Payments ----
# mock = dev checkout page that approves/declines on click. Refused when NODE_ENV=production.
PAYMENT_MODE=mock
# Staging/demo only: allow PAYMENT_MODE=mock with NODE_ENV=production (anyone can then upgrade for free).
ALLOW_MOCK_PAYMENTS=
# bKash tokenized checkout (sandbox or live base URL from your merchant account)
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ---- Mail (leave SMTP_HOST empty to log emails instead of sending) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HigherStudy <no-reply@higherstudy.app>

# ---- Worker schedules (cron, evaluated in CRON_TZ) ----
CRON_TZ=Asia/Dhaka
CRON_OUTREACH=0 9 * * *
CRON_VISA=15 9 * * *
CRON_PLANS=30 0 * * *

# ---- Web (runtime; the browser calls /api/v1 on the web origin, proxied to the API) ----
API_INTERNAL_URL=http://localhost:4000
# Proxies in front of the web app that append X-Forwarded-For (1 on Railway, 0 locally).
TRUSTED_PROXY_HOPS=0
